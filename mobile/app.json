{
  "expo": {
    "name": "Smart Reminder",
    "slug": "smart-reminder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "permissions": ["SCHEDULE_EXACT_ALARM", "ACCESS_FINE_LOCATION", "ACCESS_WIFI_STATE"],
      "adaptiveIcon": {
        "backgroundColor": "#F3F3F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Smart Reminder to use your location when you create a location reminder.",
          "locationAlwaysAndWhenInUsePermission": "Allow Smart Reminder to detect arrival and departure for your active location reminders.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders-v4-alarm-default-standard",
          "color": "#343431"
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "smartreminder"
  }
}
