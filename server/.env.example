NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://smart_reminder:smart_reminder@localhost:5432/smart_reminder
CORS_ORIGINS=http://localhost:8081
TRUST_PROXY=false
SWAGGER_ENABLED=true

# Generate an RSA keypair and base64-encode each PEM value. See server/README.md.
JWT_ACCESS_PRIVATE_KEY_BASE64=
JWT_ACCESS_PUBLIC_KEY_BASE64=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=smart-reminder-api
JWT_AUDIENCE=smart-reminder-mobile

REFRESH_TOKEN_TTL_DAYS=30
AUTH_AUDIT_PEPPER=
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
# Development deep-link base. Use a verified HTTPS universal-link domain in production.
AUTH_PUBLIC_APP_URL=smartreminder://

# Transactional account email. Required in production; no tokens are logged when omitted locally.
SMTP_URL=smtps://USERNAME:PASSWORD@SMTP_HOST:465
SMTP_FROM=noreply@your-domain.example

# Optional development seed overrides. Never use these demo accounts in production.
SEED_USER_ONE_EMAIL=demo.one@smartreminder.test
SEED_USER_ONE_PASSWORD=SmartReminder123!
SEED_USER_TWO_EMAIL=demo.two@smartreminder.test
SEED_USER_TWO_PASSWORD=SmartReminder123!
