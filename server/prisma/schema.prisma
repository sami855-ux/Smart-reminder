generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
  DELETION_PENDING
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  TOKEN_REUSE
  PASSWORD_CHANGED
  ACCOUNT_DISABLED
  EXPIRED
}

enum AuthEventType {
  REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  LOGOUT
  LOGOUT_ALL
  ACCESS_REJECTED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  DATA_EXPORTED
  ACCOUNT_DELETION_REQUESTED
}

enum AuthActionTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ReminderLifecycle {
  ACTIVE
  CANCELLED
  ARCHIVED
}

enum ScheduleType {
  ONE_TIME
  DAILY
  WEEKLY
  SELECTED_WEEKDAYS
}

enum OccurrenceLifecycle {
  SCHEDULED
  COMPLETED
  SKIPPED
  CANCELLED
}

enum ReminderEventType {
  REMINDER_CREATED
  REMINDER_UPDATED
  REMINDER_CANCELLED
  REMINDER_DELETED
  SCHEDULE_REVISED
  OCCURRENCE_RESCHEDULED
  OCCURRENCE_SNOOZED
  OCCURRENCE_COMPLETED
  OCCURRENCE_SKIPPED
  NUDGE_POLICY_UPDATED
  NOTIFICATION_REQUESTED
  NOTIFICATION_SCHEDULED
  NOTIFICATION_SCHEDULING_FAILED
  NOTIFICATION_CANCELLED
  NOTIFICATION_OPENED
  NOTIFICATION_ACTED_ON
  CHECKLIST_UPDATED
  CHECKLIST_ITEM_CHECKED
  CHECKLIST_ITEM_UNCHECKED
  WORKFLOW_CREATED
  WORKFLOW_STEP_ACTIVATED
  WORKFLOW_COMPLETED
  CONTEXT_TRIGGER_CREATED
  CONTEXT_TRIGGER_FIRED
}

enum WorkflowLifecycle {
  ACTIVE
  PAUSED
  CANCELLED
}

enum WorkflowRunLifecycle {
  ACTIVE
  COMPLETED
  STOPPED
}

enum WorkflowStepCondition {
  PREVIOUS_COMPLETED
  ALL_CHECKLIST_COMPLETED
}

enum WorkflowStepRunLifecycle {
  ACTIVE
  COMPLETED
  STOPPED
}

enum ContextTriggerType {
  LOCATION_ARRIVE
  LOCATION_LEAVE
  WIFI_CONNECT
}

enum ContextTriggerLifecycle {
  ACTIVE
  PAUSED
  UNAVAILABLE
}

enum TriggerEvaluationOutcome {
  FIRED
  SUPPRESSED
  REJECTED
}

enum ReminderActorType {
  USER
  SYSTEM
  DEVICE
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum NotificationPermissionState {
  UNKNOWN
  GRANTED
  DENIED
  PROVISIONAL
  EPHEMERAL
}

enum LockScreenPrivacy {
  FULL
  TITLE_ONLY
  PRIVATE
}

enum TimeFormat {
  H12
  H24
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  email                  String                  @unique @db.VarChar(320)
  passwordHash           String                  @map("password_hash") @db.VarChar(255)
  status                 UserStatus              @default(ACTIVE)
  locale                 String                  @default("en") @db.VarChar(35)
  timezone               String                  @default("UTC") @db.VarChar(100)
  timeFormat             TimeFormat              @default(H24) @map("time_format")
  profileRevision        Int                     @default(1) @map("profile_revision")
  emailVerifiedAt        DateTime?               @map("email_verified_at") @db.Timestamptz(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(3)
  deletionRequestedAt    DateTime?               @map("deletion_requested_at") @db.Timestamptz(3)
  purgeAfter             DateTime?               @map("purge_after") @db.Timestamptz(3)
  sessions               AuthSession[]
  authEvents             AuthSecurityEvent[]
  actionTokens           AuthActionToken[]
  reminders              Reminder[]
  reminderEvents         ReminderEvent[]
  reminderCreateRequests ReminderCreateRequest[]
  deviceInstallations    DeviceInstallation[]
  notificationPreference NotificationPreference?
  notificationAttempts   NotificationAttempt[]
  workflows              ReminderWorkflow[]
  contextTriggers        ContextTrigger[]
  triggerEvaluations     TriggerEvaluation[]

  @@map("users")
}

model Reminder {
  id                   String                  @id @default(uuid()) @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  title                String                  @db.VarChar(120)
  contextNote          String?                 @map("context_note") @db.VarChar(2000)
  lifecycle            ReminderLifecycle       @default(ACTIVE)
  revision             Int                     @default(1)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?               @map("deleted_at") @db.Timestamptz(3)
  purgeAfter           DateTime?               @map("purge_after") @db.Timestamptz(3)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules            Schedule[]
  occurrences          ReminderOccurrence[]
  events               ReminderEvent[]
  createRequests       ReminderCreateRequest[]
  nudgePolicies        NudgePolicy[]
  notificationAttempts NotificationAttempt[]
  checklistTemplates   ReminderChecklistItem[]
  sourceWorkflows      ReminderWorkflow[]      @relation("WorkflowSourceReminder")
  generatedStepRun     WorkflowStepRun?        @relation("WorkflowGeneratedReminder")
  contextTriggers      ContextTrigger[]

  @@index([userId, lifecycle, createdAt])
  @@index([lifecycle, purgeAfter])
  @@map("reminders")
}

model Schedule {
  id                   String               @id @default(uuid()) @db.Uuid
  reminderId           String               @map("reminder_id") @db.Uuid
  type                 ScheduleType
  localStartDate       String               @map("local_start_date") @db.Char(10)
  localStartTime       String               @map("local_start_time") @db.Char(5)
  timezone             String               @db.VarChar(100)
  recurrenceWeekdays   Int[]                @default([]) @map("recurrence_weekdays")
  endLocalDate         String?              @map("end_local_date") @db.Char(10)
  occurrenceCount      Int?                 @map("occurrence_count")
  resolvedStartAt      DateTime             @map("resolved_start_at") @db.Timestamptz(3)
  resolvedUtcOffsetMin Int                  @map("resolved_utc_offset_min")
  revision             Int                  @default(1)
  materializedThrough  DateTime             @map("materialized_through") @db.Timestamptz(3)
  nextEvaluationAt     DateTime?            @map("next_evaluation_at") @db.Timestamptz(3)
  supersededScheduleId String?              @map("superseded_schedule_id") @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  reminder             Reminder             @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  supersededSchedule   Schedule?            @relation("ScheduleRevision", fields: [supersededScheduleId], references: [id], onDelete: SetNull)
  replacementSchedules Schedule[]           @relation("ScheduleRevision")
  occurrences          ReminderOccurrence[]
  nudgePolicy          NudgePolicy?

  @@unique([reminderId, revision])
  @@index([reminderId, nextEvaluationAt])
  @@map("schedules")
}

model ReminderOccurrence {
  id                   String                    @id @default(uuid()) @db.Uuid
  reminderId           String                    @map("reminder_id") @db.Uuid
  scheduleId           String                    @map("schedule_id") @db.Uuid
  scheduleRevision     Int                       @map("schedule_revision")
  sequence             Int
  occurrenceKey        String                    @map("occurrence_key") @db.VarChar(160)
  originalScheduledAt  DateTime                  @map("original_scheduled_at") @db.Timestamptz(3)
  effectiveScheduledAt DateTime                  @map("effective_scheduled_at") @db.Timestamptz(3)
  localDate            String                    @map("local_date") @db.Char(10)
  localTime            String                    @map("local_time") @db.Char(5)
  lifecycle            OccurrenceLifecycle       @default(SCHEDULED)
  completedAt          DateTime?                 @map("completed_at") @db.Timestamptz(3)
  skippedAt            DateTime?                 @map("skipped_at") @db.Timestamptz(3)
  cancelledAt          DateTime?                 @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  reminder             Reminder                  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  schedule             Schedule                  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  events               ReminderEvent[]
  notificationAttempts NotificationAttempt[]
  checklistItems       OccurrenceChecklistItem[]
  sourceWorkflowRuns   WorkflowRun[]             @relation("WorkflowSourceOccurrence")
  generatedStepRun     WorkflowStepRun?          @relation("WorkflowGeneratedOccurrence")
  triggerEvaluation    TriggerEvaluation?

  @@unique([scheduleId, occurrenceKey])
  @@unique([scheduleId, sequence])
  @@index([reminderId, lifecycle, effectiveScheduledAt])
  @@map("reminder_occurrences")
}

model ReminderChecklistItem {
  id              String                    @id @default(uuid()) @db.Uuid
  reminderId      String                    @map("reminder_id") @db.Uuid
  text            String                    @db.VarChar(240)
  position        Int
  revision        Int                       @default(1)
  archivedAt      DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  reminder        Reminder                  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  occurrenceItems OccurrenceChecklistItem[]

  @@index([reminderId, archivedAt, position])
  @@map("reminder_checklist_items")
}

model OccurrenceChecklistItem {
  id           String                 @id @default(uuid()) @db.Uuid
  occurrenceId String                 @map("occurrence_id") @db.Uuid
  sourceItemId String?                @map("source_item_id") @db.Uuid
  text         String                 @db.VarChar(240)
  position     Int
  checkedAt    DateTime?              @map("checked_at") @db.Timestamptz(3)
  revision     Int                    @default(1)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  occurrence   ReminderOccurrence     @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  sourceItem   ReminderChecklistItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@unique([occurrenceId, sourceItemId])
  @@index([occurrenceId, position])
  @@map("occurrence_checklist_items")
}

model ReminderWorkflow {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  sourceReminderId String            @map("source_reminder_id") @db.Uuid
  name             String            @db.VarChar(120)
  lifecycle        WorkflowLifecycle @default(ACTIVE)
  revision         Int               @default(1)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReminder   Reminder          @relation("WorkflowSourceReminder", fields: [sourceReminderId], references: [id], onDelete: Cascade)
  steps            WorkflowStep[]
  runs             WorkflowRun[]

  @@index([userId, lifecycle, createdAt])
  @@index([sourceReminderId, lifecycle])
  @@map("reminder_workflows")
}

model WorkflowStep {
  id           String                @id @default(uuid()) @db.Uuid
  workflowId   String                @map("workflow_id") @db.Uuid
  position     Int
  title        String                @db.VarChar(120)
  contextNote  String?               @map("context_note") @db.VarChar(2000)
  delayMinutes Int                   @default(0) @map("delay_minutes")
  condition    WorkflowStepCondition @default(PREVIOUS_COMPLETED)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  workflow     ReminderWorkflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  runs         WorkflowStepRun[]

  @@unique([workflowId, position])
  @@map("workflow_steps")
}

model WorkflowRun {
  id                 String               @id @default(uuid()) @db.Uuid
  workflowId         String               @map("workflow_id") @db.Uuid
  sourceOccurrenceId String               @map("source_occurrence_id") @db.Uuid
  lifecycle          WorkflowRunLifecycle @default(ACTIVE)
  currentPosition    Int                  @default(0) @map("current_position")
  startedAt          DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(3)
  workflow           ReminderWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  sourceOccurrence   ReminderOccurrence   @relation("WorkflowSourceOccurrence", fields: [sourceOccurrenceId], references: [id], onDelete: Cascade)
  stepRuns           WorkflowStepRun[]

  @@unique([workflowId, sourceOccurrenceId])
  @@index([workflowId, lifecycle])
  @@map("workflow_runs")
}

model WorkflowStepRun {
  id                    String                   @id @default(uuid()) @db.Uuid
  runId                 String                   @map("run_id") @db.Uuid
  stepId                String                   @map("step_id") @db.Uuid
  generatedReminderId   String                   @unique @map("generated_reminder_id") @db.Uuid
  generatedOccurrenceId String                   @unique @map("generated_occurrence_id") @db.Uuid
  lifecycle             WorkflowStepRunLifecycle @default(ACTIVE)
  activatedAt           DateTime                 @default(now()) @map("activated_at") @db.Timestamptz(3)
  completedAt           DateTime?                @map("completed_at") @db.Timestamptz(3)
  run                   WorkflowRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  step                  WorkflowStep             @relation(fields: [stepId], references: [id], onDelete: Restrict)
  generatedReminder     Reminder                 @relation("WorkflowGeneratedReminder", fields: [generatedReminderId], references: [id], onDelete: Cascade)
  generatedOccurrence   ReminderOccurrence       @relation("WorkflowGeneratedOccurrence", fields: [generatedOccurrenceId], references: [id], onDelete: Cascade)

  @@unique([runId, stepId])
  @@index([runId, lifecycle])
  @@map("workflow_step_runs")
}

model ContextTrigger {
  id                 String                  @id @default(uuid()) @db.Uuid
  userId             String                  @map("user_id") @db.Uuid
  reminderId         String                  @map("reminder_id") @db.Uuid
  type               ContextTriggerType
  lifecycle          ContextTriggerLifecycle @default(ACTIVE)
  label              String                  @db.VarChar(120)
  locationCiphertext String?                 @map("location_ciphertext") @db.Text
  locationKeyVersion Int?                    @map("location_key_version")
  radiusMeters       Int?                    @map("radius_meters")
  networkFingerprint String?                 @map("network_fingerprint") @db.Char(64)
  cooldownSeconds    Int                     @default(300) @map("cooldown_seconds")
  revision           Int                     @default(1)
  lastTriggeredAt    DateTime?               @map("last_triggered_at") @db.Timestamptz(3)
  unavailableReason  String?                 @map("unavailable_reason") @db.VarChar(120)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder           Reminder                @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  evaluations        TriggerEvaluation[]

  @@index([userId, lifecycle, type])
  @@index([reminderId, lifecycle])
  @@map("context_triggers")
}

model TriggerEvaluation {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  triggerId           String                   @map("trigger_id") @db.Uuid
  installationId      String                   @map("installation_id") @db.Uuid
  eventKey            String                   @map("event_key") @db.VarChar(128)
  requestHash         String                   @map("request_hash") @db.Char(64)
  occurredAt          DateTime                 @map("occurred_at") @db.Timestamptz(3)
  receivedAt          DateTime                 @default(now()) @map("received_at") @db.Timestamptz(3)
  outcome             TriggerEvaluationOutcome
  reason              String?                  @db.VarChar(120)
  createdOccurrenceId String?                  @unique @map("created_occurrence_id") @db.Uuid
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger             ContextTrigger           @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  installation        DeviceInstallation       @relation(fields: [installationId], references: [id], onDelete: Cascade)
  createdOccurrence   ReminderOccurrence?      @relation(fields: [createdOccurrenceId], references: [id], onDelete: SetNull)

  @@unique([userId, eventKey])
  @@index([triggerId, receivedAt])
  @@map("trigger_evaluations")
}

model ReminderEvent {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  reminderId     String              @map("reminder_id") @db.Uuid
  occurrenceId   String?             @map("occurrence_id") @db.Uuid
  actorType      ReminderActorType   @map("actor_type")
  actorId        String?             @map("actor_id") @db.Uuid
  type           ReminderEventType
  metadata       Json?
  idempotencyKey String              @map("idempotency_key") @db.VarChar(128)
  requestHash    String?             @map("request_hash") @db.Char(64)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder       Reminder            @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  occurrence     ReminderOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([reminderId, createdAt])
  @@map("reminder_events")
}

model ReminderCreateRequest {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  reminderId     String   @map("reminder_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  requestHash    String   @map("request_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminder       Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([reminderId])
  @@map("reminder_create_requests")
}

model NudgePolicy {
  id                 String    @id @default(uuid()) @db.Uuid
  reminderId         String    @map("reminder_id") @db.Uuid
  scheduleId         String    @unique @map("schedule_id") @db.Uuid
  scheduleRevision   Int       @map("schedule_revision")
  enabled            Boolean   @default(false)
  intervalMinutes    Int?      @map("interval_minutes")
  invalidatedAt      DateTime? @map("invalidated_at") @db.Timestamptz(3)
  invalidationReason String?   @map("invalidation_reason") @db.VarChar(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  reminder           Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  schedule           Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([reminderId, scheduleRevision])
  @@map("nudge_policies")
}

model DeviceInstallation {
  id                   String                      @id @db.Uuid
  userId               String                      @map("user_id") @db.Uuid
  platform             DevicePlatform
  appVersion           String                      @map("app_version") @db.VarChar(40)
  permissionState      NotificationPermissionState @default(UNKNOWN) @map("permission_state")
  locale               String                      @db.VarChar(35)
  timezone             String                      @db.VarChar(100)
  revision             Int                         @default(1)
  lastSeenAt           DateTime                    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt            DateTime?                   @map("revoked_at") @db.Timestamptz(3)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationAttempts NotificationAttempt[]
  triggerEvaluations   TriggerEvaluation[]

  @@index([userId, revokedAt, lastSeenAt])
  @@map("device_installations")
}

model NotificationPreference {
  userId            String            @id @map("user_id") @db.Uuid
  quietHoursStart   String?           @map("quiet_hours_start") @db.Char(5)
  quietHoursEnd     String?           @map("quiet_hours_end") @db.Char(5)
  timezone          String            @default("UTC") @db.VarChar(100)
  lockScreenPrivacy LockScreenPrivacy @default(TITLE_ONLY) @map("lock_screen_privacy")
  globallyPaused    Boolean           @default(false) @map("globally_paused")
  revision          Int               @default(1)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model NotificationAttempt {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  occurrenceId         String             @map("occurrence_id") @db.Uuid
  deviceInstallationId String             @map("device_installation_id") @db.Uuid
  scheduleRevision     Int                @map("schedule_revision")
  effectiveScheduledAt DateTime           @map("effective_scheduled_at") @db.Timestamptz(3)
  nudgeStep            Int                @default(0) @map("nudge_step")
  logicalKey           String             @unique @map("logical_key") @db.VarChar(255)
  requestedAt          DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  locallyScheduledAt   DateTime?          @map("locally_scheduled_at") @db.Timestamptz(3)
  schedulingFailedAt   DateTime?          @map("scheduling_failed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  openedAt             DateTime?          @map("opened_at") @db.Timestamptz(3)
  actedOnAt            DateTime?          @map("acted_on_at") @db.Timestamptz(3)
  osNotificationId     String?            @map("os_notification_id") @db.VarChar(255)
  errorCode            String?            @map("error_code") @db.VarChar(80)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence           ReminderOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  reminder             Reminder           @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  reminderId           String             @map("reminder_id") @db.Uuid
  deviceInstallation   DeviceInstallation @relation(fields: [deviceInstallationId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, deviceInstallationId, scheduleRevision, effectiveScheduledAt, nudgeStep], map: "notif_attempt_occ_device_rev_instant_step_key")
  @@index([userId, updatedAt])
  @@index([deviceInstallationId, cancelledAt])
  @@map("notification_attempts")
}

model AuthActionToken {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      AuthActionTokenType
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, usedAt])
  @@index([expiresAt])
  @@map("auth_action_tokens")
}

model AuthSession {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  deviceName       String?                  @map("device_name") @db.VarChar(120)
  expiresAt        DateTime                 @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime                 @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(3)
  revocationReason SessionRevocationReason? @map("revocation_reason")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens    RefreshToken[]
  authEvents       AuthSecurityEvent[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id                String         @id @default(uuid()) @db.Uuid
  sessionId         String         @map("session_id") @db.Uuid
  tokenHash         String         @unique @map("token_hash") @db.Char(64)
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?      @map("used_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?        @unique @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  session           AuthSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy        RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: SetNull)
  replaces          RefreshToken[] @relation("RefreshTokenRotation")

  @@index([sessionId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AuthSecurityEvent {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  sessionId     String?       @map("session_id") @db.Uuid
  type          AuthEventType
  ipHash        String?       @map("ip_hash") @db.Char(64)
  userAgentHash String?       @map("user_agent_hash") @db.Char(64)
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  session       AuthSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([type, createdAt])
  @@map("auth_security_events")
}
